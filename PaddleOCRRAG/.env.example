# 数据库配置
CHROMA_DB_PATH=./data/chroma_db
RULES_DOCS_PATH=./data/rules

# 嵌入模型配置
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
HF_ENDPOINT=https://hf-mirror.com

# RAG配置
TOP_K=2
MAX_CONTEXT_LENGTH=1024

# 讯飞星火大模型配置
XUNFEI_API_KEY=your_api_key_here
XUNFEI_MODEL_ID=generalv3.5
XUNFEI_BASE_URL=wss://spark-api.xf-yun.com/v3.5/chat
XUNFEI_TEMPERATURE=0.7
XUNFEI_MAX_TOKENS=2000

# 其他配置
PROMPT_CONFIG_PATH=./config/prompts.json
